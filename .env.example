# ============================================================================
# Supabase Configuration
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_VECTOR_DIMENSION=1024

# ============================================================================
# Embedding Provider Configuration
# ============================================================================
EMBEDDING_PROVIDER=nvidia_nim  # Options: 'nvidia_nim', 'openai'

# NVIDIA NIM (Preferred - Free tier)
NVIDIA_NIM_EMBEDDING_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key

# OpenAI (Fallback if NIM unavailable)
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# LLM Provider Configuration
# ============================================================================
LLM_PROVIDER=nvidia_nim  # Options: 'nvidia_nim', 'openai', 'anthropic'

# NVIDIA NIM (Preferred - Free tier)
NVIDIA_NIM_LLM_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key (reuse from embedding config)

# OpenAI (Alternative)
OPENAI_LLM_MODEL=gpt-4o-mini

# Anthropic (Alternative)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_LLM_MODEL=claude-opus-4-1

# ============================================================================
# Application Configuration
# ============================================================================
CHUNK_SIZE=1500
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,md

# ============================================================================
# Logging & Debug
# ============================================================================
LOG_LEVEL=INFO
DEBUG=False
